@specializer array
def_native(array) {
	variant(inline) {
		type(Count);
		virtual_field(size) => Count;
	};
	variant(sized) {
		argument(count);
		virtual_field(size) => varint;
	};

	type(Value);
};

def_native(varint);
def(root_prefix) {
	export;
} => array(Count: varint) => varint;
def(root_sized_field) => container {
	virtual_field(len, value: ./v/@size) => varint;
	field(v) => array(count: ../len) => varint;
};
def(root_const_field) {
	export;
} => array(count: 3) => varint;
