name: "backend"
type: STRICT_DNS
connect_timeout { seconds: 5 nanos: 250000000 }
lb_policy: LEAST_REQUEST
load_assignment {
  cluster_name: "backend"
  endpoints {
    locality { region: "eu-west" zone: "a" }
    lb_endpoints {
      endpoint { address { socket_address { address: "10.0.0.1" port_value: 8080 } } }
      load_balancing_weight { value: 3 }
    }
    lb_endpoints {
      endpoint { address { socket_address { address: "10.0.0.2" port_value: 8080 } } }
    }
    priority: 1
  }
}
circuit_breakers {
  thresholds {
    priority: HIGH
    max_connections { value: 1024 }
    max_retries { value: 3 }
  }
}
health_checks {
  timeout { seconds: 1 }
  interval { seconds: 10 }
  unhealthy_threshold { value: 2 }
  healthy_threshold { value: 1 }
  http_health_check {
    path: "/healthz"
    expected_statuses { start: 200 end: 300 }
  }
}
outlier_detection {
  consecutive_5xx { value: 5 }
  base_ejection_time { seconds: 30 }
}
common_lb_config { healthy_panic_threshold { value: 42.5 } }
metadata {
  filter_metadata {
    key: "envoy.lb"
    value {
      fields { key: "canary" value { bool_value: true } }
      fields { key: "weight" value { number_value: -1.5 } }
      fields {
        key: "tags"
        value {
          list_value {
            values { string_value: "a" }
            values { null_value: NULL_VALUE }
            values { struct_value { fields { key: "nested" value { number_value: 7 } } } }
          }
        }
      }
    }
  }
}
typed_extension_protocol_options {
  key: "envoy.extensions.upstreams.http.v3.HttpProtocolOptions"
  value {
    type_url: "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions"
    value: "\x12\x02\x08\x01"
  }
}
per_connection_buffer_limit_bytes { value: 32768 }
ignore_health_on_host_removal: true
