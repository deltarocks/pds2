@scalar u8 @encoding be
def_native(u8);

@scalar i8 @encoding be
def_native(i8);

@scalar u16 @encoding be
def_native(u16);

@scalar bool @encoding be
def_native(bool);

@scalar i32 @encoding varint64 @protobuf varint
def_native(varint);

@scalar bytes @encoding raw @protobuf len
def_native(bytes);

@scalar f64 @encoding le @protobuf i64
def_native(double);

def_native(void) {
	is_void;
};

@specializer bitfield
def_native(bitfield) {
	body {
		item(field) {
			argument(size);

			argument(signed) => false;
		};
	};
};

@specializer bitflags
def_native(bitflags) {
	type(Value);

	body {
		item(flag);
	};
};

@specializer buffer
def_native(buffer) {
	variant(inline) {
		type(Count);
	};

	variant(sized) {
		argument(count);
	};
};

@specializer pstring
def_native(pstring) {
	type(Count);
};

@specializer registryEntryHolder
def_native(registryEntryHolder) {
	argument(baseName);

	body {
		item(field) {
			type(Value);
		};
	};
};

@specializer registryEntryHolderSet
def_native(registryEntryHolderSet) {
	argument(baseName);

	body {
		item(field) {
			type(Value);
		};
	};
};

@specializer entityMetadataLoop
def_native(entityMetadataLoop) {
	argument(end) => End;

	type(End);

	type(Value);

	body;
};

@specializer topBitSetTerminatedArray
def_native(topBitSetTerminatedArray) {
	type(Value);
};

@specializer array
def_native(array) {
	type(Value);

	variant(sized) {
		argument(count);

		virtual_field(size) => u8;
	};
};

@specializer map
def_native(map) {
	type(Count);

	type(Key);

	type(Value);
};

@specializer option
def_native(option) {
	type(Value);
};

@specializer terminated
def_native(terminated) {
	type(Value);

	type(End);

	argument(end) => End;

	body;
};

@specializer const
def_native(const) {
	type(Value);

	argument(value) => Value;

	body;
};

@specializer container
def_native(container) {
	body {
		item(field) {
			type(Value);
		};

		item(virtual_field) {
			argument(value);

			type(Value);
		};
	};
};

@specializer message
def_native(message) {
	body {
		item(field) {
			argument(number);

			type(Value);
		};

		item(implicit) {
			argument(number);

			type(Value);
		};

		item(optional) {
			argument(number);

			type(Value);
		};

		item(repeated) {
			argument(number);

			type(Value);
		};

		item(oneof) {
			argument(number);

			argument(group);

			type(Value);
		};
	};
};

@specializer enum
def_native(enum) {
	type(Tag);

	body {
		item(value) {
			argument(number);
		};
	};
};

@specializer union
def_native(union) {
	body {
		item(variant) {
			argument(match);

			type(Value) => void;
		};

		item(default) {
			anonymous;

			type(Value) => void;
		};
	};

	variant(external) {
		argument(tag);
	};

	variant(inline) {
		type(Tag);
	};
};

def(Counted) {
	export;
} => container {
	virtual_field(len, value: ./data/@size + 1) => u8;

	field(data) => array(count: ../len - 1) => u8;
};

def(Widened) {
	export;
} => container {
	field(n) => u8;

	field(items) => array(count: u16(../n) * 2) => u16;
};

fn(scaled, n: u16, by) => n * by;

def(Scaled) {
	export;
} => container {
	field(n) => u8;

	field(items) => array(count: scaled(u16(../n), 2)) => u16;
};

def(Words) {
	export;
} => terminated(end: u16(0xff00 + 0xff)) => u16;

def(BoundWords) {
	export;
} => terminated(End: u16, end: 0xffff) => u16;

def(Choice) {
	argument(k) => u8;
} => union(tag: ./$k) {
	variant(one, match: 1) => u8;

	variant(two, match: 2) => u16;
};

def(Choices) {
	export;
} => container {
	field(k) => u8;

	field(picked) => Choice(k: ../k);

	field(fixed) => Choice(k: 2);
};

def(Forward) {
	argument(k) => u8;
} => container {
	field(choice) => Choice(k: ../$k);
};

def(Wrapped) {
	type(Value);

	argument(k) => u8;
} => container {
	field(choice) => Choice(k: ../$k);

	field(value) => Value;
};

def(Nested) {
	argument(k) => u8;
} => container {
	field(field) => union(tag: ../$k) {
		variant(one, match: 1) => u8;

		variant(two, match: 2) => u16;
	};

	field(elements) => array(count: 2) => union(tag: ../../$k) {
		variant(one, match: 1) => u8;

		variant(two, match: 2) => u16;
	};

	field(arm) => union(Tag: u8) {
		variant(tagged, match: 0) => union(tag: ../../$k) {
			variant(one, match: 1) => u8;

			variant(two, match: 2) => u16;
		};

		default;
	};

	field(deep) => container {
		field(inner) => container {
			field(choice) => Choice(k: ../../../$k);
		};
	};

	field(forwarded) => Forward(k: ../$k);

	field(choices) => array(count: 2) => Choice(k: ../../$k);

	field(wrapped) => Wrapped(Value: u8, k: ../$k);
};

def(Arguments) {
	export;
} => container {
	field(k) => u8;

	field(nested) => Nested(k: ../k);
};

def(Tree) {
	export;
} => container {
	field(n) => u8;

	field(children) => array(count: ../n) => Tree;
};

def(Kind) {
	derive(Copy, Eq);
} => union(Tag: u8) {
	variant(a, match: 1);

	variant(b, match: 2) => u8;

	default;
};

def(Tagged) {
	export;
} => container {
	field(k) => Kind;

	field(v) => union(tag: ../k) {
		variant(x, match: "a");

		variant(y, match: 2) => u8;

		variant(z, match: 7);
	};

	field(o) => option => u8;

	field(w) => union(tag: ../o) {
		variant(p, match: 3) => u8;

		default;
	};
};

def(sample_counted) => const(value: Counted(data: [7, 8]));

def(sample_words) => const(value: Words([1, 0xff00]));

def(sample_choices) => const(value: Choices(k: 2, picked: (two: 9), fixed: (two: 7)));

def(sample_tagged) => const(value: Tagged(k: (b: 9), v: (y: 5), o: 3, w: (p: 4)));

def(sample_default) => const(value: Tagged(k: 7, v: z, o: none, w: (default: none)));

def(sample_flags) => const(value: [true, false, true]) => array(count: 3) => bool;

def(Packed) {
	export;
} => bitfield {
	field(x, size: 4, signed: true);

	field(y, size: 12);
};

def(Flags) {
	export;
} => bitflags {
	flag(a);

	flag(b);

	flag(c);
} => u8;

def(Blob) {
	export;
} => container {
	field(raw) => buffer(Count: u8);

	field(n) => u8;

	field(fixed) => buffer(count: ../n);

	field(name) => pstring(Count: u16);

	field(rest) => bytes;
};

def(FixedArm) {
	export;
} => union(Tag: u8) {
	variant(four, match: 0) => buffer(count: 4);
};

def(Mapped) {
	export;
} => container {
	field(entries) => map(Count: varint, Key: pstring(Count: u8)) => u16;
};

def(sample_mapped) => const(value: Mapped(entries: [(key: "a", value: 1), (key: "bc", value: 513)]));

def(encoded_mapped) => const(
	value: serialized(Mapped(entries: [(key: "a", value: 1), (key: "bc", value: 513)])),
) => bytes;

def(decoded_mapped) => const(value: Mapped(deserialized(b"\x02\x01a\x00\x01\x02bc\x02\x01")));

def(Holders) {
	export;
} => container {
	field(by_id) => registryEntryHolder(baseName: "aId") {
		field(data) => u16;
	};

	field(inline) => registryEntryHolder(baseName: "aId") {
		field(data) => u16;
	};

	field(ids) => registryEntryHolderSet(baseName: "sId") {
		field(name) => pstring(Count: u8);
	};

	field(named) => registryEntryHolderSet(baseName: "sId") {
		field(name) => pstring(Count: u8);
	};
};

def(Loop) {
	export;
} => entityMetadataLoop(end: u8(255)) => u8;

def(TopBits) {
	export;
} => topBitSetTerminatedArray => container {
	field(slot) => u8;

	field(v) => u16;
};

def(sample_packed) => const(value: Packed(x: -3, y: 4000));

def(encoded_packed) => const(value: serialized(Packed(x: -3, y: 4000))) => bytes;

def(sample_flagset) => const(value: Flags([a, c]));

def(encoded_flagset) => const(value: serialized(Flags([a, c]))) => bytes;

def(sample_blob) => const(value: Blob(raw: b"\x01\xff", n: 3, fixed: "abc", name: "pds", rest: b"!"));

def(encoded_blob) => const(
	value: serialized(Blob(raw: b"\x01\xff", n: 3, fixed: "abc", name: "pds", rest: b"!")),
) => bytes;

def(sample_holders) => const(
	value: Holders(by_id: (id: 7), inline: (data: 513), ids: (ids: [1, 300]), named: (name: "tag")),
);

def(encoded_holders) => const(
	value: serialized(
		Holders(by_id: (id: 7), inline: (data: 513), ids: (ids: [1, 300]), named: (name: "tag")),
	),
) => bytes;

def(sample_loop) => const(value: Loop([1, 2, 254]));

def(encoded_loop) => const(value: serialized(Loop([1, 2, 254]))) => bytes;

def(sample_top_bits) => const(value: TopBits([(slot: 1, v: 10), (slot: 5, v: 300)]));

def(encoded_top_bits) => const(value: serialized(TopBits([(slot: 1, v: 10), (slot: 5, v: 300)]))) => bytes;

def(encoded_counted) => const(value: serialized(Counted(data: [7, 8]))) => bytes;

def(encoded_words) => const(value: serialized(Words([1, 0xff00]))) => bytes;

def(encoded_choices) => const(value: serialized(Choices(k: 2, picked: (two: 9), fixed: (two: 7)))) => bytes;

def(encoded_tagged) => const(value: serialized(Tagged(k: (b: 9), v: (y: 5), o: 3, w: (p: 4)))) => bytes;

def(encoded_default) => const(value: serialized(Tagged(k: 7, v: z, o: none, w: (default: none)))) => bytes;

def(encoded_widened) => const(value: serialized(Widened(n: 2, items: [1, 2, 3, 0xffff]))) => bytes;

def(encoded_scaled) => const(value: serialized(Scaled(n: 4, items: [1, 2, 3, 0xffff, 5, 6, 7, 8]))) => bytes;

def(decoded_counted) => const(value: Counted(deserialized(b"\x03\x07\x08")));

def(decoded_words) => const(value: Words(deserialized(b"\x00\x01\xff\x00\xff\xff")));

def(decoded_choices) => const(value: Choices(deserialized(b"\x02\x00\x09\x00\x07")));

def(decoded_tagged) => const(value: Tagged(deserialized(b"\x02\x09\x05\x01\x03\x04")));

def(decoded_default) => const(value: Tagged(deserialized(b"\x07\x00")));

def(decoded_packed) => const(value: Packed(deserialized(serialized(Packed(x: -3, y: 4000)))));

def(decoded_flagset) => const(value: Flags(deserialized(serialized(Flags([a, c])))));

def(decoded_blob) => const(
	value: Blob(deserialized(serialized(Blob(raw: b"\x01\xff", n: 3, fixed: "abc", name: "pds", rest: b"!")))),
);

def(decoded_holders) => const(
	value: Holders(
		deserialized(
			serialized(Holders(by_id: (id: 7), inline: (data: 513), ids: (ids: [1, 300]), named: (name: "tag"))),
		),
	),
);

def(decoded_loop) => const(value: Loop(deserialized(serialized(Loop([1, 2, 254])))));

def(decoded_top_bits) => const(
	value: TopBits(deserialized(serialized(TopBits([(slot: 1, v: 10), (slot: 5, v: 300)])))),
);

def(sample_arguments) => const(
	value: Arguments(
		k: 2,
		nested: (
			field: (two: 5),
			elements: [(two: 6), (two: 7)],
			arm: (tagged: (two: 8)),
			deep: (inner: (choice: (two: 9))),
			forwarded: (choice: (two: 10)),
			choices: [(two: 11), (two: 12)],
			wrapped: (choice: (two: 13), value: 14),
		),
	),
);

def(encoded_arguments) => const(
	value: serialized(
		Arguments(
			k: 2,
			nested: (
				field: (two: 5),
				elements: [(two: 6), (two: 7)],
				arm: (tagged: (two: 8)),
				deep: (inner: (choice: (two: 9))),
				forwarded: (choice: (two: 10)),
				choices: [(two: 11), (two: 12)],
				wrapped: (choice: (two: 13), value: 14),
			),
		),
	),
) => bytes;

def(decoded_arguments) => const(
	value: Arguments(deserialized(b"\x02\x00\x05\x00\x06\x00\x07\x00\x00\x08\x00\x09\x00\x0a\x00\x0b\x00\x0c\x00\x0d\x0e")),
);

def(Leaf) {
	export;
} => message {
	field(id, number: 1) => varint;

	implicit(tag, number: 2) => varint;
};

def(Twig) {
	export;
} => message {
	implicit(n, number: 1) => varint;

	optional(m, number: 2) => varint;
};

def(Shade) => enum(Tag: varint) {
	value(SHADE_UNSPECIFIED, number: 0);

	value(SHADE_DARK, number: 1);
};

def(Branch) {
	export;
} => message {
	field(root, number: 1) => Leaf;

	optional(leaf, number: 2) => Leaf;

	implicit(weight, number: 3) => double;

	implicit(label, number: 4) => bytes;

	implicit(shade, number: 5) => Shade;

	oneof(left, number: 6, group: "side") => Leaf;

	oneof(right, number: 7, group: "side") => varint;

	oneof(middle, number: 8, group: "side") => Twig;
};

def(sample_branch) => const(value: Branch(root: (id: 0), leaf: (id: 3, tag: 4), weight: 1.5, shade: SHADE_DARK, right: 0));

def(encoded_branch) => const(
	value: serialized(Branch(root: (id: 0), leaf: (id: 3, tag: 4), weight: 1.5, shade: SHADE_DARK, right: 0)),
) => bytes;

def(decoded_branch) => const(
	value: Branch(deserialized(serialized(Branch(root: (id: 0), leaf: (id: 3, tag: 4), weight: 1.5, shade: SHADE_DARK, right: 0)))),
);

def(sample_zeros) => const(value: Branch(root: (id: 1, tag: 0), weight: 0.0, label: b"", shade: SHADE_UNSPECIFIED));

def(encoded_zeros) => const(
	value: serialized(Branch(root: (id: 1, tag: 0), weight: 0.0, label: b"", shade: SHADE_UNSPECIFIED)),
) => bytes;

def(merged_branch) => const(value: Branch(root: (id: 3, tag: 4), leaf: (id: 9, tag: 7), left: (id: 2, tag: 1)));

def(decoded_split) => const(
	value: Branch(
		deserialized(
			b"\x0a\x02\x10\x04\x0a\x02\x08\x03\x12\x02\x10\x07\x12\x02\x08\x09\x38\x05\x32\x02\x10\x01\x32\x02\x08\x02",
		),
	),
);

def(switched_branch) => const(value: Branch(root: (id: 1), middle: (m: 5)));

def(decoded_switch) => const(
	value: Branch(deserialized(b"\x0a\x02\x08\x01\x42\x02\x08\x01\x32\x02\x08\x02\x42\x02\x10\x05")),
);
