@scalar i32 @protobuf varint
def_native(int32);

@scalar bool @protobuf varint
def_native(bool);

@protobuf len
def_native(string);

def_native(void) {
	is_void;
};

@specializer message
def_native(message) {
	body {
		item(field) {
			argument(number);

			type(Value);
		};

		item(repeated) {
			argument(number);

			type(Value);
		};

		item(oneof) {
			argument(number);

			argument(group);

			type(Value);
		};
	};
};

@specializer enum
def_native(enum) {
	type(Tag);

	body {
		item(value) {
			argument(number);
		};
	};
};

namespace(google) {
	namespace(protobuf) {
		def(FileDescriptorSet) {
			export;
		} => message {
			repeated(file, number: 1) => FileDescriptorProto;
		};

		def(FileDescriptorProto) => message {
			field(name, number: 1) => string;

			field(package, number: 2) => string;

			repeated(dependency, number: 3) => string;

			repeated(message_type, number: 4) => DescriptorProto;

			repeated(enum_type, number: 5) => EnumDescriptorProto;

			field(syntax, number: 12) => string;
		};

		def(DescriptorProto) => message {
			field(name, number: 1) => string;

			repeated(field, number: 2) => FieldDescriptorProto;

			repeated(nested_type, number: 3) => DescriptorProto;

			repeated(enum_type, number: 4) => EnumDescriptorProto;

			repeated(oneof_decl, number: 8) => OneofDescriptorProto;
		};

		def(FieldDescriptorProto) => message {
			field(name, number: 1) => string;

			field(number, number: 3) => int32;

			field(label, number: 4) => FieldDescriptorProto_Label;

			field(type, number: 5) => FieldDescriptorProto_Type;

			field(type_name, number: 6) => string;

			field(oneof_index, number: 9) => int32;

			field(proto3_optional, number: 17) => bool;
		};

		def(FieldDescriptorProto_Type) => enum(Tag: int32) {
			value(TYPE_DOUBLE, number: 1);

			value(TYPE_FLOAT, number: 2);

			value(TYPE_INT64, number: 3);

			value(TYPE_UINT64, number: 4);

			value(TYPE_INT32, number: 5);

			value(TYPE_FIXED64, number: 6);

			value(TYPE_FIXED32, number: 7);

			value(TYPE_BOOL, number: 8);

			value(TYPE_STRING, number: 9);

			value(TYPE_GROUP, number: 10);

			value(TYPE_MESSAGE, number: 11);

			value(TYPE_BYTES, number: 12);

			value(TYPE_UINT32, number: 13);

			value(TYPE_ENUM, number: 14);

			value(TYPE_SFIXED32, number: 15);

			value(TYPE_SFIXED64, number: 16);

			value(TYPE_SINT32, number: 17);

			value(TYPE_SINT64, number: 18);
		};

		def(FieldDescriptorProto_Label) => enum(Tag: int32) {
			value(LABEL_OPTIONAL, number: 1);

			value(LABEL_REQUIRED, number: 2);

			value(LABEL_REPEATED, number: 3);
		};

		def(OneofDescriptorProto) => message {
			field(name, number: 1) => string;
		};

		def(EnumDescriptorProto) => message {
			field(name, number: 1) => string;

			repeated(value, number: 2) => EnumValueDescriptorProto;
		};

		def(EnumValueDescriptorProto) => message {
			field(name, number: 1) => string;

			field(number, number: 2) => int32;
		};
	};
};
