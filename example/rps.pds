namespace(protocol) {
	def_native(vu32);
	def_native(u8);

	@specializer mymap
	def_native(mymap) {
		type(Key);
		type(Value);
		type(Size) => vu32;
	};
	@specializer parray
	def_native(parray) {
		type(Value);
		type(Size) => vu32;
	};
	def(testMap) => container {
		field(testa) => mymap(Key: u8) => vu32;
		field(testb) => mymap(Key: vu32) => u8;
		field(testc) => parray => u8;
	};
};

def(test) => container {
	virtual_field(a, value: ./c) => root::protocol::u8;
	virtual_field(b, value: ./c) => root::protocol::u8;
	field(c) => root::protocol::u8;
	field(d) => radiationGuard => root::protocol::u8;
};

def(radiationGuard) {
	type(Value);
} => container {
	field(a) => Value;
	field(b) => container {
		field(c) => Value;
	};
};
